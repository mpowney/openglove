{ 
  "SearxngWebSearchTool": {
    "runner": {
      "type": "RinseAndRepeatRunner"
    },
    "baseUrl": "{SECRET:searxng-instance-url}",
    "timeout": 8000,
    "resultCount": 3,
    "params": { "engines": "duckduckgo,google,bing,brave" }
  },
  "TimeTool": {
    "timezoneHint": "local"
  },
  "MemoriesRetrievalTool": {
    "memoriesPath": "memories"
  },
  "MemoriesKeepTool": {
    "memoriesPath": "memories"
  },
  "WebBrowserTool": {
    "runner": {
      "type": "RinseAndRepeatRunner",
      "opts": { "maxRetries": 3 }
    }
  }
}
