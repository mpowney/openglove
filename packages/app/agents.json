{
  "ChatAgent": {
    "description": "Example config for the demo ChatAgent",
    "model": {
      "type": "OllamaGenerativeModel",
      "baseUrl": "{SECRET:ollama-base-url}",
      "model": "llama3.2:1b",
      "temperature": 0.7,
      "maxTokens": 2048,
      "keepAlive": 600
    },
    "skillsModel": {
      "type": "OllamaGenerativeModel",
      "baseUrl": "{SECRET:ollama-base-url}",
      "model": "olmo-3:7b-instruct",
      "temperature": 0,
      "maxTokens": 16384,
      "keepAlive": 600
    },
    "skills": { 
      "local": [ "SearxngWebSearchTool", "TimeTool", "MemoriesRetrievalTool", "MemoriesKeepTool" ],
      "socket": [ "WebBrowserTool" ]
    },
    "channels": [
      {
        "type": "BlueBubblesChannel",
        "name": "myBlueBubbles",
        "emitRoles": ["assistant"],
        "opts": {
          "baseUrl": "{SECRET:bluebubbles-base-url}",
          "threadId": "example-thread-id",
          "apiKey": "{SECRET:bluebubbles-api-key}"
        }
      },
      {
        "type": "WebSocketChannel",
        "name": "webChat",
        "emitRoles": ["assistant", "user", "system", "supplementary"],
        "opts": {
          "streaming": false,
          "port": 8080,
          "host": "localhost"
        }
      },
      {
        "type": "ConsoleChannel",
        "name": "consoleChat",
        "emitRoles": ["assistant"],
        "opts": {
          "streaming": true
        }
      }
    ]
  }
}
